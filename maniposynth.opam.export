      "md5=0740b530e8fed5b0adc5eee8463cfc2f"
    ]
  }
}
package "js_of_ocaml" {
  x-commit-hash: "6fb1d008061b6c028c375b240882bb735d54a5bc"
  opam-version: "2.0"
